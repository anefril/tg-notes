# Copy this file to .env.local and fill in your values (on Vercel: Project Settings -> Environment Variables).

# Supabase (Dashboard -> Project Settings -> API).
# Public (exposed to the browser) — project URL and anon/public key.
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-public-key

# Server-only — service role key. Used by app/api/auth/*, app/api/bot/register
# and app/api/telegram/webhook to bypass RLS. NEVER expose this to the client or commit it.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Your live site URL — used in the bot's buttons and messages, e.g. https://your-app.vercel.app
NEXT_PUBLIC_SITE_URL=

# A long random string. Required to connect a bot on /setup (stops anyone else from hijacking it).
ADMIN_SECRET=

# A long random string. Vercel Cron sends it to /api/cron/reminders (daily reminders).
CRON_SECRET=

# Optional — your fixed UTC offset in hours for "today/tomorrow" and reminders (e.g. -5, 1, 5.5). Default 0.
# NOTES_UTC_OFFSET_HOURS=0

# Reminder: in Supabase Auth settings, disable "Confirm email" — the login flow
# expects auth.signUp to return a session immediately.
